# Rust build artifacts
/target/

# Node dependencies and tool caches. The dashboard ignores its own, but a
# tool run from the repo root (vitest, npx) creates one here too.
node_modules/

# Generated JSON Schemas (emitted by the aperio-client build script)
/schemas/

# IDE configurations
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Sub-target directories
**/target/
.claude/
data/
# Coverage instrumentation artifacts
*.profraw

# LaTeX build artefacts from docs/book
docs/book/*.aux
docs/book/*.log
docs/book/*.out
docs/book/*.toc
docs/book/*.lof
docs/book/*.lot
docs/book/*.fls
docs/book/*.fdb_latexmk
docs/book/*.synctex.gz
docs/book/*.pdf

# Conformance run artefacts: the Autobahn HTML/JSON report, the generated
# fuzzingclient config, and the throwaway data directory of the server it
# brings up.
tests/conformance/reports/
tests/conformance/fuzzingclient.json
tests/conformance/.data/

# Staged binaries for the native-package build (packaging/nfpm-*.yaml)
/dist/
