# ==============================================================================
# APERIO ENVIRONMENT VARIABLES REFERENCE (.env.example)
# ==============================================================================
# Copy this file to .env in your respective running directory or set these in your shell.

# ------------------------------------------------------------------------------
# APERIO SERVER CONFIGURATION (aperio-server)
# ------------------------------------------------------------------------------

# The server reads only these boot settings from its environment. Every other
# setting (proxy trust, limits, timeouts, the visitor gate, ...) lives in its
# database and is changed from the dashboard's Settings, or seeded on the first
# start from the document APERIO_INIT_FILE names. A variable that used to
# configure the server refuses the start and names the setting replacing it.

# [REQUIRED] The secret authentication token that clients must provide in order
# to connect. It also signs in to the dashboard as the built-in `aperio` admin.
APERIO_SERVER_TOKEN=super-secret-token-change-me

# The address to bind the Aperio server to. Defaults to all interfaces.
HOST=0.0.0.0

# The port on which the Aperio server will listen for public traffic.
PORT=8080

# Where the database, the audit log and the settings live. Default ./data.
# APERIO_DATA_DIR=./data

# A settings document (yaml or json) applied once, on the first start.
# APERIO_INIT_FILE=./server-init.yaml

# Logging Level (alternative to RUST_LOG for a simpler interface)
# Available values: error, warn, info, debug, trace
LOG_LEVEL=debug


# ------------------------------------------------------------------------------
# APERIO CLIENT CONFIGURATION (aperio-client)
# ------------------------------------------------------------------------------

# [REQUIRED] Token matching the APERIO_SERVER_TOKEN of the server.
# APERIO_SERVER_TOKEN=super-secret-token-change-me

# [REQUIRED] Public URL of the running Aperio proxy server.
APERIO_SERVER_URL=http://localhost:8080

# [REQUIRED] Address of your local server target to route the public traffic to.
APERIO_TARGET=http://127.0.0.1:3000

# Set to "1" to forward the original HTTP "Host" header sent by the public user
# to your target backend. If "0" (default), Host header will be rewritten to match APERIO_TARGET.
APERIO_PASS_HOSTNAME=0

# Optional path prefix to bind this client to. Only requests matching this path
# prefix will be routed to this client. Clients without a path bind serve as fallback.
# APERIO_PATH=/api/v2
# When set to "1" (default if APERIO_PATH is set), strips the path bind prefix
# from the incoming request before forwarding to the backend.
# Example: With bind=/test and trim=true, GET /test/hello becomes GET /hello.
# APERIO_TRIM_BIND=1

# Maximum response body size in bytes accepted from the target backend (OOM protection).
# Default is 52428800 bytes = 50 MB.
# APERIO_MAX_RESPONSE_BODY=52428800

# Per-request timeout in seconds for requests made to the local target backend.
# Default is 30 seconds.
# APERIO_TIMEOUT=30

# Logging Level (alternative to RUST_LOG for a simpler interface)
# LOG_LEVEL=debug

