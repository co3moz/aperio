# A client instance, copied rather than edited in place:
#
#   cp /etc/aperio/aperio-client.yaml.example /etc/aperio/myapp.yaml
#   $EDITOR /etc/aperio/myapp.yaml
#   systemctl enable --now aperio-client@myapp
#
# The instance name after the @ is the file name: aperio-client@myapp reads
# /etc/aperio/myapp.yaml. One machine usually fronts more than one thing, and
# each gets its own file and its own service.
#
# These files hold tunnel tokens, so /etc/aperio is 0750 root:aperio and the
# client reads them as the `aperio` user.

server:
  url: https://tunnel.example.com
  token: apr_change_me

# What to expose, and under which name. `target` is a backend this machine can
# reach; `serve` is a directory of static files instead. See
# docs/configuration.md for the full set, including several services from one
# process.
target: http://127.0.0.1:3000
hostname: myapp.example.com

version: __APERIO_VERSION__
