{
  "name": "aperio-e2e",
  "private": true,
  "type": "module",
  "description": "End-to-end suite, Node port. Runs beside tests/e2e.sh, not instead of it.",
  "scripts": {
    "pretest": "cargo build --manifest-path ../../Cargo.toml -p aperio-server -p aperio-client -p mock-h2",
    "test": "nole './specs/**/*.test.ts' --concurrency 4",
    "pretest:ci": "npm run pretest",
    "test:ci": "nole './specs/**/*.test.ts' --concurrency 2",
    "pretest:serial": "npm run pretest",
    "test:serial": "nole './specs/**/*.test.ts'",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "nole": "^3.4.0",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "ws": "^8.21.2"
  }
}
