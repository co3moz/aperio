# The Aperio server's boot settings, read by aperio-server.service.
#
# Package upgrades never overwrite this file; a new default lands beside it as
# aperio-server.env.rpmnew or .dpkg-dist for you to diff.
#
# Only what the server needs before its database opens lives here. Every
# other setting is stored in the database under /var/lib/aperio and changed
# from the dashboard (Settings) or `PUT /aperio/api/settings`, without a
# restart. Every setting is in docs/reference.md.

# The master token. Clients present it to connect, and it signs in to the
# dashboard as `aperio:<token>`. Change it before starting, and treat it the
# way you treat a root password.
APERIO_SERVER_TOKEN=apr_change_me_before_starting

# The address the service listens on, in plain HTTP. For HTTPS, either put
# it behind a reverse proxy (nginx, Caddy, Traefik) that holds the
# certificate, as this loopback address assumes, or turn on the built-in
# HTTPS listener (`tls` in server-init.yaml). That one listens on this HOST
# too, so set it to 0.0.0.0 or the public address. See "In front of the
# server" in docs/deployment.md.
HOST=127.0.0.1
PORT=8080

# The settings a new server starts with, read once into an empty database.
APERIO_INIT_FILE=/etc/aperio/server-init.yaml
